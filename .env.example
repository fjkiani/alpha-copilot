# OpenRouter — LLM provider for all agents (route, stream, profiler, followup, generate-context)
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# AssemblyAI — real-time speech-to-text with speaker diarization
# Get key at https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# App URL (used for OpenRouter HTTP-Referer header)
NEXT_PUBLIC_APP_URL=http://localhost:3000
